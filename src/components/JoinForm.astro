---

---

<section id="join" class="join-section theme-dark section-padding">
  <div class="container join-container">
    <div class="join-info">
      <span class="section-tag-gold">JOIN NOVOGUIDE</span>
      <h2 class="join-title">
        Ready to take the next step<br />in your implant journey?
      </h2>

      <p class="join-description">
        Whether you're beginning with guided surgery or already placing implants
        regularly, we'd love to have you as part of NovoGuide.
      </p>

      <div class="benefits-row">
        <div class="benefit-item">
          <div class="benefit-icon">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="12" y1="2" x2="12" y2="5"></line>
              <line x1="12" y1="19" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="5" y2="12"></line>
              <line x1="19" y1="12" x2="22" y2="12"></line>
            </svg>
          </div>
          <div class="benefit-text">
            <span>Expert Planning</span>
            <span>Support</span>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="10" cy="7" r="4"></circle>
              <path d="M18 8a3 3 0 0 1 0 6"></path>
              <path d="M21 5a7 7 0 0 1 0 12"></path>
            </svg>
          </div>
          <div class="benefit-text">
            <span>Clinical Community</span>
            <span>Access</span>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
              <path d="M4 22h16"></path>
              <path
                d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1c0 .55.45 1 1 1h8c.55 0 1-.45 1-1v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34"
              ></path>
              <path
                d="M6 4h12a2 2 0 0 1 2 2v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6V6a2 2 0 0 1 2-2Z"
              ></path>
            </svg>
          </div>
          <div class="benefit-text">
            <span>Grow Your</span>
            <span>Confidence</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Side Form Box -->
    <div class="join-form-wrapper">
      <form id="novo-join-form" class="join-form">
        <div class="form-row">
          <div class="form-group">
            <input
              type="text"
              id="fullName"
              name="fullName"
              placeholder="Full Name"
              required
              class="form-input"
            />
          </div>
          <div class="form-group">
            <input
              type="text"
              id="practiceName"
              name="practiceName"
              placeholder="Practice Name"
              required
              class="form-input"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Email Address"
              required
              class="form-input"
            />
          </div>
          <div class="form-group">
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="Phone Number"
              required
              class="form-input"
            />
          </div>
        </div>

        <div class="form-group">
          <div class="select-wrapper">
            <select
              id="monthlyImplants"
              name="monthlyImplants"
              required
              class="form-input form-select"
            >
              <option value="" disabled selected
                >How many implants do you place per month?</option
              >
              <option value="0-2">0 - 2 implants / month</option>
              <option value="3-5">3 - 5 implants / month</option>
              <option value="6-10">6 - 10 implants / month</option>
              <option value="10+">10+ implants / month</option>
            </select>
            <svg
              class="select-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </div>

        <div class="form-group">
          <div class="select-wrapper">
            <select
              id="supportNeed"
              name="supportNeed"
              required
              class="form-input form-select"
            >
              <option value="" disabled selected
                >What would you most like support with?</option
              >
              <option value="cbct-planning"
                >CBCT Radiology & Surgical Planning</option
              >
              <option value="guided-surgery"
                >Surgical Guide Production & Kits</option
              >
              <option value="mentorship"
                >Clinical Mentorship & Case Review</option
              >
              <option value="full-workflow"
                >End-to-End Guided Implant Workflow</option
              >
            </select>
            <svg
              class="select-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </div>

        <button type="submit" class="btn-gold-submit">
          <span>JOIN THE COMMUNITY</span>
          <svg
            class="btn-arrow"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

        <p class="privacy-note">
          We respect your privacy. Your information is safe with us.
        </p>
      </form>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="join-toast" class="toast-notification">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="var(--gold-primary)"
      stroke-width="2"
      ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
        points="22 4 12 14.01 9 11.01"></polyline></svg
    >
    <span>Welcome to NovoGuide! Your registration has been received.</span>
  </div>
</section>

<style>
  .join-section {
    background-color: #060709;
    border-top: 1px solid var(--border-dark);
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .join-container {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: 4.5rem;
    align-items: center;
  }

  .join-info {
    display: flex;
    flex-direction: column;
  }

  .section-tag-gold {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1.25rem;
    display: inline-block;
  }

  .join-title {
    font-size: clamp(2.2rem, 3.4vw, 3.1rem);
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 1.5rem;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .join-description {
    font-size: 0.95rem;
    color: #9aa0a6;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 440px;
  }

  /* Horizontal Benefits Row */
  .benefits-row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 3.25rem;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .benefit-icon {
    color: var(--gold-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .benefit-text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: #9aa0a6;
    line-height: 1.25;
  }

  /* Form Container */
  .join-form-wrapper {
    width: 100%;
  }

  .join-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .form-group {
    width: 100%;
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .select-wrapper .select-chevron {
    position: absolute;
    right: 1.15rem;
    top: 50%;
    transform: translateY(-50%);
    color: #636872;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    background: #121316;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 0.95rem 1.15rem;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    outline: none;
    transition: var(--transition-smooth);
  }

  .form-input::placeholder {
    color: #636872;
    font-size: 0.88rem;
  }

  .form-input:focus {
    border-color: var(--gold-primary);
    background: #14161a;
    box-shadow: 0 0 14px var(--gold-glow);
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }

  .form-select option {
    background-color: #121316;
    color: #ffffff;
  }

  /* Submit Button */
  .btn-gold-submit {
    width: 100%;
    background-color: var(--gold-primary);
    color: #0c0d10;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    padding: 1.05rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: var(--transition-smooth);
    cursor: pointer;
    border: none;
    margin-top: 0.35rem;
  }

  .btn-gold-submit:hover {
    background-color: var(--gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 163, 98, 0.28);
  }

  .btn-arrow {
    position: absolute;
    right: 1.5rem;
    transition: transform 0.3s ease;
  }

  .btn-gold-submit:hover .btn-arrow {
    transform: translateX(4px);
  }

  .privacy-note {
    font-size: 0.78rem;
    color: #636872;
    text-align: center;
    margin-top: 0.4rem;
  }

  /* Toast Notification */
  .toast-notification {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: #14171c;
    border: 1px solid var(--border-gold);
    color: #ffffff;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toast-notification.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 960px) {
    .join-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .join-title br {
      display: none;
    }

    .benefits-row {
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .benefits-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const form = document.getElementById("novo-join-form") as HTMLFormElement;
  const toast = document.getElementById("join-toast");

  if (form && toast) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      // Show confirmation toast
      toast.classList.add("show");
      form.reset();

      setTimeout(() => {
        toast.classList.remove("show");
      }, 4500);
    });
  }
</script>
