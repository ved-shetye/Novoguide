---

---

<footer class="footer theme-dark">
  <div class="container footer-container">
    <!-- Brand Column -->
    <div class="footer-brand">
      <a href="#" class="logo">
        <div class="logo-icon">n</div>
        <span class="logo-text">novoguide</span>
      </a>

      <div class="brand-tagline">
        <p>Guiding clinicians.</p>
        <p>Guiding surgery.</p>
        <p>Growing together.</p>
      </div>

      <div class="social-links">
        <a href="#" aria-label="Instagram" class="social-link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="#" aria-label="YouTube" class="social-link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
            ></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
            ></polygon>
          </svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="social-link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
    </div>

    <!-- Services Links -->
    <div class="footer-col">
      <h4 class="col-title">SERVICES</h4>
      <ul class="footer-links">
        <li><a href="#">Implant Planning</a></li>
        <li><a href="#">CBCT Reporting</a></li>
        <li><a href="#">Surgical Guides</a></li>
        <li><a href="#">Planning Only</a></li>
      </ul>
    </div>

    <!-- Company Links -->
    <div class="footer-col">
      <h4 class="col-title">COMPANY</h4>
      <ul class="footer-links">
        <li><a href="#about">About Us</a></li>
        <li><a href="#">Our Team</a></li>
        <li><a href="#case-studies">Testimonials</a></li>
        <li><a href="#join">Contact</a></li>
      </ul>
    </div>

    <!-- Let's Connect Column -->
    <div class="footer-col connect-col">
      <h4 class="col-title">LET'S CONNECT</h4>
      <p class="connect-text">
        Join our community of clinicians and receive the latest insights, cases
        and updates.
      </p>
      <a href="#join" class="btn-connect">
        <span>JOIN NOVOGUIDE</span>
        <svg
          class="connect-arrow"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="footer-bottom">
    <div class="container bottom-container">
      <p class="copyright">© 2024 NovoGuide. All rights reserved.</p>
      <div class="legal-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #060709;
    border-top: 1px solid var(--border-dark);
    padding-top: 2.5rem;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.35fr;
    gap: 3.5rem;
    padding-bottom: 1.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--gold-primary);
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--gold-primary);
    font-size: 1.15rem;
    line-height: 1;
    background: transparent;
  }

  .logo-text {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .brand-tagline {
    font-size: 0.85rem;
    color: #8a909a;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-link {
    color: #8a909a;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .social-link:hover {
    color: var(--gold-primary);
    transform: translateY(-2px);
  }

  .col-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: #8a909a;
    transition: var(--transition-smooth);
  }

  .footer-links a:hover {
    color: var(--gold-primary);
  }

  .connect-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .connect-text {
    font-size: 0.85rem;
    color: #8a909a;
    margin-bottom: 1.25rem;
    line-height: 1.55;
    max-width: 320px;
  }

  .btn-connect {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--gold-primary);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--gold-primary);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .btn-connect:hover {
    background: rgba(217, 163, 98, 0.1);
    border-color: var(--gold-hover);
    color: var(--gold-hover);
    transform: translateY(-2px);
  }

  .connect-arrow {
    transition: transform 0.3s ease;
  }

  .btn-connect:hover .connect-arrow {
    transform: translateX(4px);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.5rem 0;
  }

  .bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #636872;
  }

  .copyright {
    color: #636872;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .legal-links a {
    color: #8a909a;
    transition: var(--transition-smooth);
  }

  .legal-links a:hover {
    color: var(--gold-primary);
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .bottom-container {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
</style>
