---
import { Image } from "astro:assets";
import img1 from "../assets/Blog/img1.png";
import img2 from "../assets/Blog/img2.png";
import img3 from "../assets/Blog/img3.png";

const articles = [
  {
    type: "CASE STUDY",
    title: "Immediate UL1 implant – from CBCT to guided placement",
    linkText: "Read case study",
    image: img1,
    url: "#",
  },
  {
    type: "CLINICAL GUIDE",
    title: "When should you consider an indirect sinus lift?",
    linkText: "Read guide",
    image: img2,
    url: "#",
  },
  {
    type: "IMPLANT FUNDAMENTALS",
    title: "Understanding bone quality in implant dentistry",
    linkText: "Read article",
    image: img3,
    url: "#",
  },
];
---

<section id="blog" class="blog-section theme-light section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">LEARN WITH NOVOGUIDE</span>
      <h2 class="section-title">Insights, cases and clinical guidance.</h2>
    </div>

    <div class="blog-grid">
      {
        articles.map((item) => (
          <article class="blog-card">
            <div class="card-media">
              <Image src={item.image} alt={item.title} class="blog-img" />
            </div>

            <div class="card-body">
              <span class="category-tag">{item.type}</span>
              <h3 class="article-title">{item.title}</h3>
              <a href={item.url} class="read-link">
                <span>{item.linkText}</span>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <>
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </>
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="blog-cta-wrapper">
      <a href="#" class="btn-outline-dark blog-cta">VIEW ALL ARTICLES & CASES</a
      >
    </div>
  </div>
</section>

<style>
  .blog-section {
    background-color: var(--bg-light-main);
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 2.5rem auto;
  }

  .section-title {
    font-size: clamp(2rem, 3.1vw, 2.8rem);
    font-weight: 500;
    color: var(--text-light-title);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .blog-card {
    background: var(--bg-light-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    transition: var(--transition-smooth);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.08);
    border-color: rgba(217, 163, 98, 0.4);
  }

  .card-media {
    width: 100%;
    aspect-ratio: 20 / 9;
    overflow: hidden;
  }

  .blog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-img {
    transform: scale(1.06);
  }

  .card-body {
    padding: 1.6rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .category-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-secondary);
    margin-bottom: 0.3rem;
  }

  .article-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-light-title);
    margin-bottom: 1.4rem;
    line-height: 1.35;
    flex-grow: 1;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-light-muted);
    transition: var(--transition-smooth);
  }

  .read-link:hover {
    color: var(--gold-secondary);
    gap: 0.75rem;
  }

  .blog-cta-wrapper {
    text-align: center;
  }

  .blog-cta {
    background: transparent;
    color: var(--text-light-title);
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .blog-cta:hover {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
